{
  "name": "focusdeck",
  "private": true,
  "version": "0.1.0",
  "description": "第三屏全屏生产力工作台：待办、番茄钟、课程表式日程三合一，中英双语，可选自托管同步",
  "license": "MIT",
  "author": "Picadoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Picadoo/focusdeck.git"
  },
  "homepage": "https://github.com/Picadoo/focusdeck#readme",
  "bugs": {
    "url": "https://github.com/Picadoo/focusdeck/issues"
  },
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 --import ./scripts/dev-guard.mjs ./node_modules/vite/bin/vite.js",
    "dev:raw": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build": "tauri build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "cap:sync": "pnpm build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "pnpm cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tauri-apps/cli": "~2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.2"
  }
}
