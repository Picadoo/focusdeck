# 全部可选。一行都不改也能 docker compose up -d --build 起来，
# 首次启动会生成初始密码打印在日志里。想固定配置再复制成 .env 修改。

# 对外端口与绑定地址。默认只绑回环，靠 nginx/caddy 反代；
# 想让局域网/公网直连就把 BIND 改成 0.0.0.0。
HOST_PORT=8787
BIND=127.0.0.1

# 登录账号。密码二选一，都不填就用自动生成的（见首次启动日志）。
FOCUSDECK_USER=focus
# 明文密码，容器启动时自己算哈希，适合自用
FOCUSDECK_PASSWORD=
# 预先算好的哈希，适合不想让明文进 .env 的场景：
#   docker compose run --rm --entrypoint node focusdeck dist/hash-password.js 你的密码
FOCUSDECK_PASSWORD_HASH=

# 留空则首次启动生成并存进数据卷，容器重建后 token 不失效。
JWT_SECRET=

# 前后端分开部署时填 API 的对外地址；同源部署留空。
VITE_API_BASE=

# 容器名与内存上限，同机跑多份实例时改这两个
CONTAINER_NAME=focusdeck
MEM_LIMIT=512m
